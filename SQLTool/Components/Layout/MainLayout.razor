@* SQLTool/Components/Layout/MainLayout.razor *@
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <nav class="sqltool-nav">
            <span class="brand">SQLTool</span>
            <div class="nav-links">
                <a href="/">Run Query</a>
                <AuthorizeView Roles="SQLTool.Admin" Context="adminContext">
                    <a href="/admin/queries">Manage Queries</a>
                    <a href="/admin/environments">Environments</a>
                </AuthorizeView>
            </div>
            <span class="user-info">
                @context.User.Identity?.Name
                <a href="/MicrosoftIdentity/Account/SignOut">Sign out</a>
            </span>
        </nav>
        <main class="sqltool-main">
            @Body
        </main>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
