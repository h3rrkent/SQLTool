@* SQLTool/Components/Pages/Admin/ManageQueries.razor *@
@page "/admin/queries"
@attribute [Authorize(Policy = "AdminPolicy")]
@rendermode InteractiveServer
@using SQLTool.Models
@using SQLTool.Services
@inject IConfigService ConfigService

<h2>Manage Queries</h2>
<div class="admin-header">
    <span class="config-hint">Source: queries.json · @_allQueries.Count queries</span>
    <button @onclick="ReloadConfig">🔄 Reload Config</button>
    <button @onclick="AddNew">+ Add Query</button>
</div>

@foreach (var q in _allQueries)
{
    <div class="query-row @(!q.Enabled ? "disabled" : "")">
        <div class="query-info">
            <strong>@q.Name</strong>
            <small>@q.Parameters.Count param(s) · @string.Join(", ", q.AllowedEnvironments)</small>
        </div>
        <span class="status-badge @(q.Enabled ? "active" : "inactive")">@(q.Enabled ? "Active" : "Disabled")</span>
        <button @onclick="() => StartEdit(q)">✏ Edit</button>
        @if (q.Enabled)
        {
            <button class="danger" @onclick="() => SoftDelete(q.Id)">Disable</button>
        }
        else
        {
            <button @onclick="() => Enable(q.Id)">Enable</button>
        }
        @if (_confirmDeleteId == q.Id)
        {
            <span class="confirm-delete">Remove permanently?
                <button class="danger" @onclick="() => ConfirmHardDelete(q.Id)">Yes</button>
                <button @onclick="() => _confirmDeleteId = null">Cancel</button>
            </span>
        }
        else
        {
            <button class="danger" @onclick="() => _confirmDeleteId = q.Id">Remove permanently</button>
        }
    </div>

    @if (_editing is { } session && session.Draft.Id == q.Id)
    {
        <div class="edit-form">
            @if (_editErrors is not null)
            {
                <div class="edit-errors">@_editErrors</div>
            }
            <div class="form-row">
                <label>Display Name</label>
                <input @bind="session.Draft.Name" />
            </div>
            <div class="form-row">
                <label>Description</label>
                <input @bind="session.Draft.Description" />
            </div>
            <div class="form-row">
                <label>Allowed Environments</label>
                @foreach (var env in _allEnvNames)
                {
                    <label><input type="checkbox" checked="@session.Draft.AllowedEnvironments.Contains(env)"
                                  @onchange="e => ToggleEnv(env, (bool)(e.Value ?? false))" /> @env</label>
                }
            </div>
            <div class="form-row">
                <label>SQL</label>
                <textarea @bind="session.Draft.Sql" rows="5"></textarea>
                <small>Use @@ParameterName for parameters</small>
            </div>
            <div class="params-editor">
                <h4>Parameters <button @onclick="AddParam">+ Add</button></h4>
                @for (var i = 0; i < session.Draft.Parameters.Count; i++)
                {
                    var idx = i;
                    var p = session.Draft.Parameters[idx];
                    <div class="param-row">
                        <input placeholder="SQL Name (e.g. StartDate)" @bind="p.Name" />
                        <input placeholder="Label (shown to user)" @bind="p.Label" />
                        <select @bind="p.Type">
                            <option value="text">Text</option>
                            <option value="date">Date</option>
                            <option value="number">Number</option>
                            <option value="boolean">Yes/No</option>
                            <option value="dropdown">Dropdown</option>
                        </select>
                        <label><input type="checkbox" @bind="p.Required" /> Required</label>
                        @if (p.Type == "dropdown")
                        {
                            <div class="dropdown-opts">
                                <small>Options (value:label, one per line)</small>
                                <textarea rows="3"
                                          value="@session.DropdownText.GetValueOrDefault(idx, "")"
                                          @onchange="e => { session.DropdownText[idx] = e.Value?.ToString() ?? string.Empty; SyncDropdownOptions(idx); }"></textarea>
                            </div>
                        }
                        <button class="danger" @onclick="() => RemoveParam(idx)">🗑</button>
                    </div>
                }
            </div>
            <div class="form-actions">
                <button @onclick="CancelEdit">Cancel</button>
                <button class="primary" @onclick="SaveEdit">💾 Save to config</button>
            </div>
        </div>
    }
}

@if (_editing is { } newSession && !_allQueries.Any(q => q.Id == newSession.Draft.Id))
{
    <div class="edit-form">
        @if (_editErrors is not null)
        {
            <div class="edit-errors">@_editErrors</div>
        }
        <div class="form-row">
            <label>Display Name</label>
            <input @bind="newSession.Draft.Name" />
        </div>
        <div class="form-row">
            <label>Description</label>
            <input @bind="newSession.Draft.Description" />
        </div>
        <div class="form-row">
            <label>Allowed Environments</label>
            @foreach (var env in _allEnvNames)
            {
                <label><input type="checkbox" checked="@newSession.Draft.AllowedEnvironments.Contains(env)"
                              @onchange="e => ToggleEnv(env, (bool)(e.Value ?? false))" /> @env</label>
            }
        </div>
        <div class="form-row">
            <label>SQL</label>
            <textarea @bind="newSession.Draft.Sql" rows="5"></textarea>
            <small>Use @@ParameterName for parameters</small>
        </div>
        <div class="params-editor">
            <h4>Parameters <button @onclick="AddParam">+ Add</button></h4>
            @for (var i = 0; i < newSession.Draft.Parameters.Count; i++)
            {
                var idx = i;
                var p = newSession.Draft.Parameters[idx];
                <div class="param-row">
                    <input placeholder="SQL Name (e.g. StartDate)" @bind="p.Name" />
                    <input placeholder="Label (shown to user)" @bind="p.Label" />
                    <select @bind="p.Type">
                        <option value="text">Text</option>
                        <option value="date">Date</option>
                        <option value="number">Number</option>
                        <option value="boolean">Yes/No</option>
                        <option value="dropdown">Dropdown</option>
                    </select>
                    <label><input type="checkbox" @bind="p.Required" /> Required</label>
                    @if (p.Type == "dropdown")
                    {
                        <div class="dropdown-opts">
                            <small>Options (value:label, one per line)</small>
                            <textarea rows="3"
                                      value="@newSession.DropdownText.GetValueOrDefault(idx, "")"
                                      @onchange="e => { newSession.DropdownText[idx] = e.Value?.ToString() ?? string.Empty; SyncDropdownOptions(idx); }"></textarea>
                        </div>
                    }
                    <button class="danger" @onclick="() => RemoveParam(idx)">🗑</button>
                </div>
            }
        </div>
        <div class="form-actions">
            <button @onclick="CancelEdit">Cancel</button>
            <button class="primary" @onclick="SaveEdit">💾 Save to config</button>
        </div>
    </div>
}

@code {
    private sealed record EditSession(QueryDefinition Draft, Dictionary<int, string> DropdownText);
    private EditSession? _editing;

    private List<QueryDefinition> _allQueries = new();
    private List<string> _allEnvNames = new();
    private string? _confirmDeleteId;
    private string? _editErrors;

    protected override void OnInitialized() => LoadData();

    private void LoadData()
    {
        _allQueries = ConfigService.GetAllQueries().ToList();
        _allEnvNames = ConfigService.GetEnvironments().Select(e => e.Name).ToList();
    }

    private void ReloadConfig() { ConfigService.Reload(); LoadData(); }

    private void AddNew()
    {
        var newQuery = new QueryDefinition { Id = Guid.NewGuid().ToString("N")[..8] };
        _editErrors = null;
        _editing = new EditSession(newQuery, new Dictionary<int, string>());
    }

    private void StartEdit(QueryDefinition q)
    {
        _editErrors = null;
        var draft = new QueryDefinition
        {
            Id = q.Id, Name = q.Name, Description = q.Description,
            AllowedEnvironments = new(q.AllowedEnvironments),
            Sql = q.Sql, Enabled = q.Enabled,
            Parameters = q.Parameters.Select(p => new QueryParameter
            {
                Name = p.Name, Label = p.Label, Type = p.Type,
                Required = p.Required, Min = p.Min, Max = p.Max,
                Options = new(p.Options)
            }).ToList()
        };
        var dropdownText = draft.Parameters
            .Select((p, i) => (i, string.Join("\n", p.Options.Select(o => $"{o.Value}:{o.Label}"))))
            .ToDictionary(x => x.i, x => x.Item2);
        _editing = new EditSession(draft, dropdownText);
    }

    private void CancelEdit() { _editing = null; _editErrors = null; }

    private void SaveEdit()
    {
        if (_editing is not { } session) return;

        if (string.IsNullOrWhiteSpace(session.Draft.Name) || string.IsNullOrWhiteSpace(session.Draft.Sql))
        {
            _editErrors = "Name and SQL are required.";
            return;
        }

        // Sync all dropdown options before saving
        for (var i = 0; i < session.Draft.Parameters.Count; i++)
        {
            if (session.Draft.Parameters[i].Type == "dropdown")
                SyncDropdownOptions(i);
        }
        foreach (var p in session.Draft.Parameters)
            if (p.Name.StartsWith('@')) p.Name = p.Name[1..];

        ConfigService.SaveQuery(session.Draft);
        _editing = null;
        _editErrors = null;
        LoadData();
    }

    private void SoftDelete(string id) { ConfigService.DeleteQuery(id, permanent: false); LoadData(); }
    private void ConfirmHardDelete(string id) { _confirmDeleteId = null; ConfigService.DeleteQuery(id, permanent: true); LoadData(); }
    private void Enable(string id) { ConfigService.EnableQuery(id); LoadData(); }

    private void AddParam()
    {
        if (_editing is not { } session) return;
        session.Draft.Parameters.Add(new());
        session.DropdownText[session.Draft.Parameters.Count - 1] = "";
    }

    private void RemoveParam(int idx)
    {
        if (_editing is not { } session) return;
        session.Draft.Parameters.RemoveAt(idx);
        var newMap = new Dictionary<int, string>();
        for (var i = 0; i < session.Draft.Parameters.Count; i++)
            newMap[i] = session.DropdownText.GetValueOrDefault(i < idx ? i : i + 1, "");
        session.DropdownText.Clear();
        foreach (var kvp in newMap)
            session.DropdownText[kvp.Key] = kvp.Value;
    }

    private void ToggleEnv(string env, bool add)
    {
        if (_editing is not { } session) return;
        if (add && !session.Draft.AllowedEnvironments.Contains(env)) session.Draft.AllowedEnvironments.Add(env);
        else if (!add) session.Draft.AllowedEnvironments.Remove(env);
    }

    private void SyncDropdownOptions(int idx)
    {
        if (_editing is not { } session) return;
        var lines = session.DropdownText.GetValueOrDefault(idx, "").Split('\n', StringSplitOptions.RemoveEmptyEntries);
        session.Draft.Parameters[idx].Options = lines
            .Select(l => l.Split(':', 2))
            .Where(parts => parts.Length == 2)
            .Select(parts => new DropdownOption { Value = parts[0].Trim(), Label = parts[1].Trim() })
            .ToList();
    }
}
